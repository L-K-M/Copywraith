{
	"extends": "$app/tsconfig",
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler",
		// tsgo resolves `#lib` through package.json imports but loses prop
		// types for `.svelte` files; map the subpath explicitly for the checker.
		"paths": {
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"]
		}
	}
}
