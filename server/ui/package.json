{
  "name": "copywraith-server-ui",
  "private": true,
  "version": "0.3.1",
  "license": "Unlicense",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../../scripts/third-party-notices.mjs --config third-party-notices.jsonc --modules node_modules/.cache/bundled-modules --check-assets dist --title \"Copywraith server UI\" --out dist/Third-Party-Notices.txt",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --tsgo",
    "test": "vitest run",
    "check:ts6": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@lkmc/system7-ui": "^0.3.0",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@typescript/native": "npm:typescript@~7.0.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
