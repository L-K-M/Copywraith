{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],

		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,

		"allowJs": true,
		"checkJs": true,

		// Type-check only; Vite owns emit.
		"noEmit": true
	},
	"include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte", "vite.config.js", "svelte.config.js"]
}
